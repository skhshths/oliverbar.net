# The in-browser Linux VM assets are large (~10 MB) and never change,
# so cache them hard. Without this, every visit re-downloads the disk
# image and wasm.
/vm/*
  Cache-Control: public, max-age=31536000, immutable

/vm/v86.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
